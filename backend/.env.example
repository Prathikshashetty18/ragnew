# Groq API Configuration (Highly Recommended)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback: Google/Gemini API Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Security Key for CDSS App (Highly Recommended)
# If set, secures the API so that client requests must pass this key in the X-API-Key header.
# Example: CDSS_API_KEY=my_secure_clinical_token_1234
CDSS_API_KEY=dev_secret_key_to_protect_endpoints

# Database Configuration (Optional)
DATABASE_URL=sqlite:///./clinical_rag.db

# Model Names (Defaults)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Upload File Size Limit (Default: 25 MB)
MAX_UPLOAD_SIZE_MB=25
