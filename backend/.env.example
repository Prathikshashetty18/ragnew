# ==============================================================================
# Clinical RAG Hospital CDSS - Backend Environment Configuration
# ==============================================================================

# --- Environment & Server Network ---
# Set to 'production' for live deployments, or 'development' for local work.
# In production mode, application startup strictly requires JWT_SECRET_KEY.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# --- Security & JWT Authentication ---
# REQUIRED in production mode! Defaults to an insecure development key in development mode.
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32).
# NEVER commit your real production JWT secret to version control.
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Initial Admin Password (used only when database is initialized for the first time)
ADMIN_DEFAULT_PASSWORD=Admin@123

# --- CORS Allowed Origins ---
# Comma-separated list of allowed frontend origins for browser API requests.
# In production, set this to your deployed frontend domain (e.g. https://cdss-hospital.example.com).
# Defaults to local Vite and React development server origins if left unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Database Configuration ---
# Defaults to <project>/backend/clinical_rag_v2.db (SQLite) anchored to BASE_DIR.
# Can be overridden with an absolute path or custom connection string.
DATABASE_URL=sqlite:///./clinical_rag_v2.db

# --- Persistent Storage Directories ---
# Defaults are automatically anchored to the backend directory:
# UPLOAD_DIR: Authoritative uploaded clinical documents, lab attachments, and scans (MUST persist across restarts).
# VECTOR_STORE_DIR: Derived FAISS vector index and BM25 index (persistence recommended to avoid rebuilding on restart).
# SEED_DIR: Static reference clinical guidelines bundled with the repository (read-only).
# UPLOAD_DIR=/path/to/persistent/uploads
# VECTOR_STORE_DIR=/path/to/persistent/vector_store

# --- Upload Limits & Memory Protection ---
# Maximum allowed file upload size in megabytes (enforced via Content-Length and bounded 64 KB streaming).
MAX_UPLOAD_SIZE_MB=25

# --- AI & LLM Provider Configuration ---
# Primary LLM Provider: Groq (Highly Recommended)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary Fallback LLM Provider: Google Gemini (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Local Embedding & Cross-Encoder Models (HuggingFace cache)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Legacy / Deprecated Configuration ---
# CDSS_API_KEY was used in earlier prototypes. Current API authentication is strictly JWT Bearer token-based.
# Retained for backward compatibility, but not required or used for endpoint authorization.
CDSS_API_KEY=

